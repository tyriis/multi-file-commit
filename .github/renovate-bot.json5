{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  username: "tyriis-bot[bot]",
  gitAuthor: "tyriis-bot <133711747+tyriis-bot[bot]@users.noreply.github.com>",
  platformCommit: "enabled",
  platform: "github",
  repositories: ["tyriis/multi-file-commit"],
  // The postUpgradeTasks in .github/renovate.json5 rebuild the committed
  // dist/ bundle. Commands run without a shell and are refused unless they
  // match this list, which is a global-only option and therefore cannot live
  // in the repository config.
  allowedCommands: ["^pnpm install --frozen-lockfile$", "^pnpm build$"],
}
